{
  "description": "MacroPad coding-agent activity lights for Codex",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/MacroPad.app/Contents/MacOS/MacroPad agent-hook codex",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/MacroPad.app/Contents/MacOS/MacroPad agent-hook codex",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/MacroPad.app/Contents/MacOS/MacroPad agent-hook codex",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/MacroPad.app/Contents/MacOS/MacroPad agent-hook codex",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/MacroPad.app/Contents/MacOS/MacroPad agent-hook codex",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
